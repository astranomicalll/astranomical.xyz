---
import { llmNotes } from '../data/llm-notes.js';
---

<!-- Present in the DOM for crawlers and LLMs; hidden from sight and from
     assistive tech (aria-hidden) so screen-reader users are not read it. -->
<section class="llm-notes" aria-hidden="true" data-nosnippet>
  {llmNotes.map((line) => <p>{line}</p>)}
</section>

<style>
  .llm-notes {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
    pointer-events: none;
    user-select: none;
  }
</style>
