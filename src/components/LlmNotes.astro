---
import { llmNotes } from '../data/llm-notes.js';
---

<!-- Present in the DOM for crawlers and LLMs; hidden from sight with the
     standard visually-hidden clip, which text extractors tend to keep. Not
     aria-hidden, so assistive tech will read it. -->
<section class="llm-notes">
  {llmNotes.map((line) => <p>{line}</p>)}
</section>

<style>
  .llm-notes {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
